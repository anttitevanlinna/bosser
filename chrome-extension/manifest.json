{
  "manifest_version": 3,
  "name": "Bosser LinkedIn Assistant",
  "version": "2.0.6",
  "description": "Chrome extension for automated LinkedIn publishing with server-orchestrated workflows and intelligent article detection",
  
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "scripting"
  ],
  
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://media.licdn.com/*"
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bosser LinkedIn Assistant"
  },
  
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content-test.js"],
      "run_at": "document_idle"
    }
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "web_accessible_resources": [
    {
      "resources": [],
      "matches": ["https://www.linkedin.com/*"]
    }
  ]
}